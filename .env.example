# Copy this file to .env and fill in the values.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public address of the app, used for links in emails.
BASE_URL=http://localhost:5000

# SQLite database. Leave blank to use instance/library.db
DATABASE_URL=

# PoC test features (banner, quick logins, "pretend today", seed). Set to false in production.
TEST_MODE=true

# Email. Mailpit listens on localhost:1025; its inbox is at http://localhost:8025
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=library@drumshanbo-music-library.example

# Where librarian notifications go (can also be changed in admin Settings).
LIBRARIAN_EMAIL=librarian@example.com

# Web push. Run `flask generate-vapid` and paste the two key lines here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:librarian@example.com
